  {
    "id": "AISTD-209",
    "title": "验证系统识别全部存储设备且健康状态正常",
    "source": "Jira",
    "scope": "core",
    "kind": "disk_inventory",
    "group": "function",
    "profiles": [],
    "criteria": [
      "每块物理盘均按SN唯一映射到BOM，数量、型号、容量和接口一致；无缺盘、重复盘或无法确认归属设备。",
      "设计要求的控制器均被识别并绑定批准驱动，无未绑定或异常状态。",
      "每块支持SMART的磁盘均完成只读检查；总体健康正常，关键属性不超过批准阈值。不支持设备须记录原因和所需厂商工具，不得直接PASS。",
      "每个NVMe均按SN完成查询；critical_warning为0，media/data integrity errors为0或不超过批准基线，测试期间unsafe shutdown无新增。",
      "BOM全部物理盘均有且仅有一条枚举和健康记录；无遗漏、错盘、未解释告警或超批准阈值属性。"
    ],
    "limitation": "",
    "url": "https://jira.pcg.riverbegin.cn/browse/AISTD-209",
    "scope_reason": "统一计划中的自动硬盘用例",
    "execution_route": "automatic"
  },
